{
  "name": "summer-haven",
  "version": "1.0.0",
  "description": "A painterly browser exploration game: make a character, ride a bicycle and find your own summer.",
  "license": "MIT",
  "author": "Token Gremlin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Token-Gremlin/summer-haven.git"
  },
  "homepage": "https://github.com/Token-Gremlin/summer-haven#readme",
  "bugs": {
    "url": "https://github.com/Token-Gremlin/summer-haven/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "check:publication": "node tools/release/check-publication.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vite": "8.3.1"
  }
}
